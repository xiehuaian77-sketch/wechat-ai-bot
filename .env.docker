# Docker 生产环境配置（通过 docker-compose 环境变量覆盖）
APP_ENV=production
DEBUG=false
SERVER_WORKERS=2

# ComWeChatRobot（宿主机运行，通过 network_mode: host 或端口映射）
WECHAT_HOOK_URL=http://host.docker.internal:19088
WECHAT_HOOK_SECRET=

# 数据库（Docker 内部路径）
DATABASE_URL=sqlite+aiosqlite:///./data/wechat_ai_bot.db

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# 知识库
CHROMA_DB_PATH=/app/data/chroma_db
CHROMA_COLLECTION_NAME=wechat_knowledge

# 日志
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# 限流
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_USER=20
RATE_LIMIT_IP=50

# 管理后台（生产环境必须设置白名单）
ADMIN_WHITELIST=wxid_xxxxx
GROUP_BLACKLIST=